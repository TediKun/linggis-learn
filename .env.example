# Supabase Configuration
# Isi ketiga variabel berikut dari Project Settings -> API di Dashboard Supabase Anda.
# Untuk fitur Login Email + Password tanpa kendala limit email gratis, matikan opsi "Confirm email"
# pada menu Authentication -> Providers -> Email di Dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opsional: email untuk menaikkan kuota harian fallback terjemahan MyMemory (50.000 karakter/hari)
MYMEMORY_EMAIL=

# Opsional: alamat website produksi untuk sitemap & SEO metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
